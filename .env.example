AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_FROM_EMAIL=Smart Campus <login@your-domain.example>
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# Optional: override the default generated campus index path.
# CAMPUSES_DATA_FILE=C:\path\to\campuses.json

# Firebase Admin — Firestore (server-side). Free (Spark) plan is enough.
FIREBASE_SERVICE_ACCOUNT_PATH=./.secrets/firebase-service-account.json
# Or paste the service account JSON on a single line instead of a path:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}

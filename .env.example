AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional: preview the UI without signing in during next dev. Ignored in production.
# DEV_SKIP_LOGIN=true
AUTH_FROM_EMAIL=Smart Campus <login@your-domain.example>
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# Sender used for certificate batches; falls back to AUTH_FROM_EMAIL.
CERTIFICATE_FROM_EMAIL=Smart Campus <certificates@your-domain.example>
# Optional: public origin used to build absolute image URLs (ICEBRKR logo,
# event banner) inside certificate emails. Defaults to the production domain.
# APP_BASE_URL=https://ibcampus.icebrkr.space
# Optional: a single-IP header overwritten by your trusted reverse proxy.
# Leave unset unless direct backend access is blocked and the proxy replaces it.
# Without it, public certificate lookups share a 20/minute quota.
# CERTIFICATE_CLIENT_IP_HEADER=x-real-ip
# Optional: override the default generated campus index path.
# CAMPUSES_DATA_FILE=C:\path\to\campuses.json

# Firebase Admin — Firestore (server-side). Free (Spark) plan is enough.
FIREBASE_SERVICE_ACCOUNT_PATH=./.secrets/firebase-service-account.json
# Development only: persist app/auth records under .local-data without Firebase.
# LOCAL_DATA_STORE=true
# Or paste the service account JSON on a single line instead of a path:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}
